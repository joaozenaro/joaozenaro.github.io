---
import Layout from '../layouts/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import heatsyncImg from '../assets/heatsync-dash.png'
import agoriumImg from '../assets/agorium.png'
import parkhubImg from '../assets/parkhub.png'

const work = [
    {
        title: 'heatsync',
        description:
            "HeatSync is a full-stack IoT dashboard for monitoring humidity and temperature in real time. It's built on a Next.js frontend backed by a NestJS API following hexagonal architecture, with live sensor data streamed over WebSockets.",
        href: 'https://github.com/joaozenaro/heatsync',
        image: heatsyncImg,
        action: 'View on GitHub',
        featured: true,
        stack: ['Next.js', 'NestJS', 'WebSockets', 'Hexagonal Architecture'],
    },
    {
        title: 'agorium',
        description:
            'Agorium is a gamified educational app where students connect, ask questions, and share knowledge. With subject-linked posts and a ranking system, it turns learning into a social and interactive experience.',
        href: 'https://github.com/zjefersound/agorium',
        image: agoriumImg,
        action: 'View on GitHub',
    },
    {
        title: 'park-hub',
        description:
            'ParkHub is a parking management application built using an unusual PHP framework assigned through a random draw.',
        href: 'https://github.com/joaozenaro/park-hub',
        image: parkhubImg,
        action: 'View on GitHub',
    },
]
---

<Layout title="João Zenaro" description="Software developer.">
    <div class="w-full">
        <section
            class="min-h-[calc(100vh-100px)] max-md:min-h-auto max-md:py-20 flex flex-col justify-center gap-4 max-w-4xl mx-auto p-8"
        >
            <p class="text-sm text-[var(--fg-subtle)]">Welcome, I'm</p>
            <h1
                class="text-6xl md:text-[5.5rem] leading-[0.95] font-bold tracking-normal"
            >
                João M. Zenaro
            </h1>

            <p
                class="text-lg leading-relaxed max-w-[45ch] text-[var(--fg-muted)]"
            >
                I'm a software developer based in Brazil, specializing in .NET
                and web technologies. You can read my <a
                    href="/blog"
                    class="text-[var(--accent)] underline decoration-[color-mix(in_srgb,var(--accent)_30%,transparent)] underline-offset-4 transition-colors hover:text-[var(--fg)] hover:decoration-white/80"
                    >blog</a
                >, check out my <a
                    href="/tools"
                    class="text-[var(--accent)] underline decoration-[color-mix(in_srgb,var(--accent)_30%,transparent)] underline-offset-4 transition-colors hover:text-[var(--fg)] hover:decoration-white/80"
                    >tools</a
                >, or see my <a
                    href="/resume"
                    class="text-[var(--accent)] underline decoration-[color-mix(in_srgb,var(--accent)_30%,transparent)] underline-offset-4 transition-colors hover:text-[var(--fg)] hover:decoration-white/80"
                    >resume</a
                >.
            </p>
        </section>

        <section
            class="w-full max-w-4xl mx-auto pt-16 pb-24 px-8"
            aria-labelledby="outside-work-title"
        >
            <div class="mb-6 pb-4 border-b border-white/10">
                <p class="text-sm text-[var(--fg-subtle)]">Outside work</p>
                <h2
                    id="outside-work-title"
                    class="text-3xl leading-tight font-bold tracking-normal"
                >
                    Some personal projects
                </h2>
            </div>

            <div class="flex flex-col gap-5">
                <ProjectCard
                    title={work[0].title}
                    description={work[0].description}
                    href={work[0].href}
                    image={work[0].image}
                    action={work[0].action}
                    isLcp={true}
                    featured={true}
                    stack={work[0].stack}
                />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    {
                        work
                            .slice(1)
                            .map((item) => (
                                <ProjectCard
                                    title={item.title}
                                    description={item.description}
                                    href={item.href}
                                    image={item.image}
                                    action={item.action}
                                />
                            ))
                    }
                </div>
            </div>
        </section>
    </div>
</Layout>
