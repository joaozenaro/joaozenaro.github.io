---
import Layout from '../../layouts/Layout.astro'

interface Tool {
    id: string
    name: string
    description: string
    href: string
}

const tools: Tool[] = [
    {
        id: 'snip',
        name: 'Snip',
        description:
            'Clipboard image annotation tool. Paste an image, annotate it, and copy it back to your clipboard.',
        href: '/tools/snip',
    },
]
---

<Layout title="Tools" description="Useful web tools and utilities">
    <section class="flex-1 flex justify-center py-12 px-6">
        <div class="w-full max-w-3xl flex flex-col">
            <h1
                class="text-3xl font-bold text-[var(--fg)] mb-8 tracking-tight border-b border-white/10 pb-3"
            >
                Tools
            </h1>
            <div class="grid grid-cols-1 gap-5" aria-label="Available tools">
                {
                    tools.map((tool) => (
                        <a
                            class="group no-underline text-inherit block p-6 bg-white/2 border border-white/10 rounded-md transition-colors duration-150 hover:bg-white/5 hover:border-[var(--accent)]"
                            href={tool.href}
                        >
                            <h2 class="text-[1.35rem] font-semibold text-[var(--fg)] m-0 mb-2 leading-tight">
                                {tool.name}
                            </h2>
                            <p class="text-[0.95rem] leading-relaxed text-[#dbdbdb]/85 m-0">
                                {tool.description}
                            </p>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
