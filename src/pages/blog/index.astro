---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

const formatDate = (date: Date) =>
    new Intl.DateTimeFormat('en', {
        month: 'long',
        day: '2-digit',
        year: 'numeric',
    }).format(date)
---

<Layout title="Blog" description="My personal web blog" viewTransitions>
    <section class="flex-1 flex justify-center py-12 px-6">
        <div class="w-full max-w-3xl flex flex-col">
            <h1
                class="text-3xl font-bold text-[var(--fg)] mb-8 tracking-tight border-b border-white/10 pb-3"
            >
                Archive
            </h1>
            {
                posts.length === 0 ? (
                    <p class="text-lg opacity-60 mt-4 italic">
                        No posts yet. Stay tuned!
                    </p>
                ) : (
                    <ol
                        class="list-none flex flex-col gap-5 p-0 m-0"
                        aria-label="Blog posts"
                    >
                        {posts.map((post) => {
                            return (
                                <a
                                    class="group no-underline text-inherit block"
                                    href={`/blog/${post.id}/`}
                                >
                                    <li
                                        class="p-6 bg-white/2 border border-white/10 rounded-md transition-colors duration-150 box-border group-hover:bg-white/5 group-hover:border-[var(--accent)]"
                                        transition:name={`post-card-${post.id}`}
                                    >
                                        <h2 class="text-[1.35rem] font-semibold text-[var(--fg)] mb-1.5 leading-tight transition-colors duration-150">
                                            {post.data.title}
                                        </h2>
                                        <time
                                            class="text-sm opacity-50 block mb-3 tracking-wide"
                                            datetime={post.data.date.toISOString()}
                                        >
                                            {formatDate(post.data.date)}
                                        </time>
                                        <p class="text-[0.95rem] leading-relaxed text-[#dbdbdb]/85 m-0">
                                            {post.data.description}
                                        </p>
                                    </li>
                                </a>
                            )
                        })}
                    </ol>
                )
            }
        </div>
    </section>
</Layout>
