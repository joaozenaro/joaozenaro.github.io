---
import { getCollection, render } from 'astro:content'
import 'katex/dist/katex.min.css'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => !data.draft)

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const formatDate = (date: Date) =>
    new Intl.DateTimeFormat('en', {
        month: 'long',
        day: '2-digit',
        year: 'numeric',
    }).format(date)

const tocHeadings = headings.filter((h) => h.depth > 1 && h.depth <= 3)
---

<Layout title={post.data.title} description={post.data.title} viewTransitions>
    <div
        class="w-full max-w-[720px] mx-auto py-12 px-6 grid grid-cols-1 gap-10 xl:grid-cols-[240px_minmax(0,720px)_240px] xl:max-w-7xl xl:gap-8"
    >
        <article
            class="flex flex-col w-full min-w-0 bg-white/2 border border-white/10 rounded-md p-8 box-border xl:col-start-2"
            transition:name={`post-card-${post.id}`}
        >
            <header class="mb-10 border-b border-white/10 pb-6">
                <h1
                    class="text-[clamp(1.75rem,5vw,2.5rem)] leading-[1.15] font-bold text-[var(--fg)] mb-2 tracking-tight"
                >
                    {post.data.title}
                </h1>
                <time
                    datetime={post.data.date.toISOString()}
                    class="text-sm opacity-50 tracking-wide"
                >
                    {formatDate(post.data.date)}
                </time>
            </header>
            <div
                class="flex-1 text-[1.05rem] leading-relaxed text-[#dbdbdb]/90 [&_p]:mb-6 [&_:is(h2,h3,h4,h5,h6)]:text-[var(--fg)] [&_:is(h2,h3,h4,h5,h6)]:font-semibold [&_:is(h2,h3,h4,h5,h6)]:leading-tight [&_:is(h2,h3,h4,h5,h6)]:mt-10 [&_:is(h2,h3,h4,h5,h6)]:mb-4 [&_:is(h2,h3,h4,h5,h6):first-child]:mt-0 [&_h2]:text-2xl [&_h2]:border-b [&_h2]:border-white/10 [&_h2]:pb-1.5 [&_h3]:text-xl [&_h4]:text-[1.1rem] [&_pre]:p-5 [&_pre]:rounded-md [&_pre]:border [&_pre]:border-white/10 [&_pre]:overflow-x-auto [&_pre]:my-8 [&_pre]:text-sm [&_pre]:leading-relaxed [&_:not(pre)>code]:text-[0.9em] [&_:not(pre)>code]:bg-white/10 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded [&_:not(pre)>code]:text-[#e5c07b] [&_:not(pre)>code]:break-words [&_:is(ul,ol)]:mt-0 [&_:is(ul,ol)]:mb-6 [&_:is(ul,ol)]:pl-6 [&_li]:mb-2 [&_ul]:list-square [&_ol]:list-decimal [&_img]:max-w-full [&_img]:h-auto [&_img]:block [&_img]:mx-auto [&_img]:my-10 [&_img]:rounded-md [&_img]:border [&_img]:border-white/10 [&_blockquote]:my-8 [&_blockquote]:px-5 [&_blockquote]:py-3 [&_blockquote]:border-l-[3px] [&_blockquote]:border-[var(--accent)] [&_blockquote]:bg-white/5 [&_blockquote]:text-[#dbdbdb]/85 [&_blockquote]:italic [&_blockquote_p]:mb-0 [&_table]:w-full [&_table]:border-collapse [&_table]:my-8 [&_table]:text-[0.95rem] [&_th]:p-3 [&_th]:border-b-2 [&_th]:border-white/20 [&_th]:text-left [&_th]:font-semibold [&_th]:text-[var(--fg)] [&_td]:p-3 [&_td]:border-b [&_td]:border-white/10 [&_td]:text-left [&_tr:hover_td]:bg-white/5 [&_a]:text-[#61afef] [&_a]:no-underline [&_a]:border-b [&_a]:border-dashed [&_a]:border-[#61afef]/60 [&_a]:transition-colors [&_a]:duration-150 [&_a:hover]:text-[var(--fg)] [&_a:hover]:border-[var(--fg)]"
            >
                <Content />
            </div>
            <footer class="mt-16 pt-8 border-t border-white/10">
                <a
                    href="/blog"
                    class="text-[0.9rem] no-underline text-[var(--fg)] opacity-60 inline-flex items-center gap-2 transition-opacity duration-150 hover:opacity-100"
                >
                    Go back
                </a>
            </footer>
        </article>

        {
            tocHeadings.length > 0 && (
                <aside class="hidden xl:block xl:col-start-3 sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto">
                    <nav class="py-2" aria-label="Table of contents">
                        <span class="text-xs uppercase tracking-wide opacity-50 block mb-3 font-semibold">
                            On this page
                        </span>
                        <ul class="list-none p-0 m-0 flex flex-col gap-2">
                            {tocHeadings.map((heading) => (
                                <li
                                    class={`text-[0.95rem] leading-relaxed ${heading.depth === 3 ? 'pl-5' : ''}`}
                                >
                                    <a
                                        href={`#${heading.slug}`}
                                        class="toc-link no-underline text-[var(--fg)] opacity-50 transition-all duration-150 inline-block border-l-[3px] border-transparent pl-2 hover:opacity-100 [&.active]:font-bold [&.active]:text-[var(--accent)] [&.active]:border-[var(--accent)] [&.active]:opacity-100"
                                    >
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                </aside>
            )
        }
    </div>
</Layout>

<script>
    function setupScrollSpy() {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id
                        if (!id) return

                        // Remove active class from all links, add to the current one
                        document
                            .querySelectorAll('.toc-link')
                            .forEach((link) => {
                                link.classList.remove('active')
                            })

                        const activeLink = document.querySelector(
                            `.toc-link[href="#${id}"]`
                        )
                        if (activeLink) {
                            activeLink.classList.add('active')
                        }
                    }
                })
            },
            { rootMargin: '0px 0px -50% 0px' }
        )

        // Observe all markdown headings
        document
            .querySelectorAll('h1, h2, h3, h4')
            .forEach((heading) => observer.observe(heading))
    }

    document.addEventListener('astro:page-load', setupScrollSpy)
</script>
