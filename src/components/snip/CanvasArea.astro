<div
    id="edit-area"
    class="hidden justify-center items-center w-full h-full p-6 box-border overflow-auto"
>
    <div
        id="canvas-wrap"
        class="relative inline-block rounded-lg overflow-hidden"
    >
        <img
            id="source-image"
            alt="Pasted image"
            draggable="false"
            class="block max-w-full max-h-[calc(100vh-120px)] w-auto h-auto select-none pointer-events-none"
        />
        <canvas
            id="edit-canvas"
            class="absolute top-0 left-0 w-full h-full block [&.tool-select]:cursor-default [&.tool-draw]:cursor-crosshair"
        ></canvas>
    </div>
</div>
