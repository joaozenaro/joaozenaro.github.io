---
const colors = [
    { name: 'Red', hex: '#ff3b30' },
    { name: 'Green', hex: '#34c759' },
    { name: 'Blue', hex: '#007aff' },
    { name: 'Yellow', hex: '#ffcc00' },
    { name: 'Purple', hex: '#af52de' },
    { name: 'White', hex: '#ffffff' },
    { name: 'Black', hex: '#000000' },
] as const

const { active = '#ff3b30' } = Astro.props
---

<div
    role="radiogroup"
    aria-label="Color"
    id="color-picker"
    class="inline-flex items-center gap-1.5 px-1"
>
    {
        colors.map((c) => (
            <button
                type="button"
                role="radio"
                aria-checked={c.hex === active}
                aria-label={c.name}
                data-color={c.hex}
                style={`--swatch: ${c.hex}`}
                class="w-[18px] h-[18px] p-0 rounded-full border-[1.5px] border-white/15 bg-[var(--swatch)] cursor-pointer outline-none transition-all duration-100 ease-in hover:scale-110 aria-checked:border-white/90 aria-checked:shadow-[0_0_0_2px_rgba(255,255,255,0.15)]"
            />
        ))
    }
</div>
