---
import {
    MousePointer2,
    Square,
    MoveUpRight,
    Grid3x3Icon,
    Undo2,
    Redo,
    Copy,
    Download,
} from '@lucide/astro'

const { id, attr, name, label, tooltip, pressed } = Astro.props

const icons = {
    select: MousePointer2,
    rect: Square,
    arrow: MoveUpRight,
    pixelate: Grid3x3Icon,
    undo: Undo2,
    redo: Redo,
    copy: Copy,
    download: Download,
} as const

type Tool = keyof typeof icons

const ToolIcon = icons[attr as Tool] ?? MousePointer2
---

<button
    id={id}
    aria-pressed={pressed}
    tabindex="-1"
    data-tool={attr}
    data-tooltip={tooltip || 'Not implemented yet'}
    aria-label={label}
    class={`inline-flex items-center gap-1 h-[28px] border-none rounded-md bg-transparent text-white/40 font-sans text-[0.8125rem] leading-none cursor-pointer transition-colors duration-100 whitespace-nowrap outline-none hover:not-aria-disabled:bg-white/5 hover:not-aria-disabled:text-white/85 aria-pressed:bg-white/10 aria-pressed:text-white/90 [&.active]:bg-white/10 [&.active]:text-white/90 aria-disabled:opacity-30 aria-disabled:cursor-not-allowed aria-disabled:pointer-events-none ${name ? 'px-2' : 'p-0 w-[28px] justify-center'}`}
>
    <ToolIcon size={15} />
    {name && <span>{name}</span>}
</button>
