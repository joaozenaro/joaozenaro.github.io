---
import { Image } from 'astro:assets'

interface Props {
    title: string
    description: string
    href: string
    image: ImageMetadata
    action: string
    isLcp?: boolean
    featured?: boolean
    stack?: string[]
}

const {
    title,
    description,
    href,
    image,
    action,
    isLcp = false,
    featured = false,
    stack,
} = Astro.props
---

<a
    class={`group flex flex-col min-w-0 text-inherit no-underline bg-white/2 border border-white/10 rounded-md overflow-hidden transition-colors duration-150 hover:bg-white/5 hover:border-[var(--accent)]${featured ? ' md:flex-row md:min-h-[22rem]' : ''}`}
    href={href}
>
    <div
        class={`relative flex-none w-full bg-white/5 overflow-hidden${featured ? ' md:flex-[0_0_55%] md:w-[55%] md:aspect-auto md:border-b-0 md:border-r md:border-white/10 aspect-[16/9] border-b border-white/10' : ' aspect-[16/9] border-b border-white/10'}`}
    >
        <Image
            src={image}
            alt={`Screenshot of ${title}`}
            loading={isLcp ? 'eager' : 'lazy'}
            fetchpriority={isLcp ? 'high' : 'auto'}
            widths={[400, 800]}
            sizes="(max-width: 760px) 100vw, 50vw"
            quality={80}
            class="absolute inset-0 w-full h-full object-cover block"
        />
    </div>
    <span
        class={`flex flex-1 flex-col gap-3 p-5${featured ? ' md:justify-center md:p-8 md:gap-4' : ''}`}
    >
        <span
            class={`font-semibold leading-tight${featured ? ' md:text-[1.75rem] text-[1.35rem] max-md:text-[1.35rem]' : ' text-[1.15rem]'}`}
            >{title}</span
        >
        <span
            class={`flex-1 leading-relaxed text-[var(--fg-muted)]${featured ? ' md:text-base text-[0.95rem]' : ' text-[0.95rem]'}`}
            >{description}</span
        >
        {
            stack && stack.length > 0 && (
                <span class="flex flex-wrap gap-1.5">
                    {stack.map((tech: string) => (
                        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-[var(--fg-muted)] tracking-wide">
                            {tech}
                        </span>
                    ))}
                </span>
            )
        }
        <span
            class="text-[var(--accent)] text-sm underline decoration-[color-mix(in_srgb,var(--accent)_30%,transparent)] underline-offset-4 transition-colors duration-150 group-hover:text-[var(--fg)] group-hover:decoration-white/80"
            >{action}</span
        >
    </span>
</a>
