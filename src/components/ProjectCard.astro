---
import { Image } from 'astro:assets'

interface Props {
    title: string
    description: string
    href: string
    image: ImageMetadata
    action: string
    isLcp?: boolean
    featured?: boolean
    stack?: string[]
}

const { title, description, href, image, action, isLcp = false, featured = false, stack } = Astro.props
---

<a class={`project-card${featured ? ' project-card--featured' : ''}`} href={href}>
    <div class="project-card-img-wrap">
        <Image
            src={image}
            alt={`Screenshot of ${title}`}
            loading={isLcp ? 'eager' : 'lazy'}
            fetchpriority={isLcp ? 'high' : 'auto'}
            widths={[400, 800]}
            sizes="(max-width: 760px) 100vw, 50vw"
            quality={80}
            class="project-card-img"
        />
    </div>
    <span class="project-card-body">
        <span class="work-title">{title}</span>
        <span class="work-description">{description}</span>
        {stack && stack.length > 0 && (
            <span class="work-stack">
                {stack.map((tech: string) => (
                    <span class="stack-badge">{tech}</span>
                ))}
            </span>
        )}
        <span class="work-action">{action}</span>
    </span>
</a>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        color: inherit;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        overflow: hidden;
        transition:
            background-color 150ms ease,
            border-color 150ms ease;
    }

    .project-card:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: var(--accent);
    }

    /* ── Image wrapper (flex child) ── */
    .project-card-img-wrap {
        position: relative;
        flex: none;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid var(--border-subtle);
    }

    .project-card-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* ── Featured (hero) card ── */
    .project-card--featured {
        flex-direction: row;
        min-height: 22rem;
    }

    .project-card--featured .project-card-img-wrap {
        flex: 0 0 55%;
        width: 55%;
        aspect-ratio: unset;  /* height driven by the card row */
        border-bottom: none;
        border-right: 1px solid var(--border-subtle);
    }

    .project-card--featured .project-card-body {
        flex: 1;
        justify-content: center;
        padding: 2rem;
        gap: 1rem;
    }

    .project-card--featured .work-title {
        font-size: 1.75rem;
    }

    .project-card--featured .work-description {
        font-size: 1rem;
    }

    .project-card-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.25rem;
    }

    .work-title {
        font-size: 1.15rem;
        line-height: 1.3;
        font-weight: 600;
    }

    .work-description {
        flex: 1;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--fg-muted);
    }

    .work-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .stack-badge {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--fg-muted);
        letter-spacing: 0.02em;
    }

    .work-action {
        color: var(--accent);
        font-size: 0.9rem;
        text-decoration: underline;
        text-decoration-color: color-mix(
            in srgb,
            var(--accent) 30%,
            transparent
        );
        text-underline-offset: 4px;
        transition:
            color 150ms ease,
            text-decoration-color 150ms ease;
    }

    .project-card:hover .work-action {
        color: var(--fg);
        text-decoration-color: rgb(255 255 255 / 0.8);
    }

    @media (max-width: 760px) {
        .project-card--featured {
            flex-direction: column;
            min-height: unset;
        }

        .project-card--featured .project-card-img-wrap {
            flex: none;
            width: 100%;
            aspect-ratio: 16 / 9;
            border-right: none;
            border-bottom: 1px solid var(--border-subtle);
        }

        .project-card--featured .project-card-body {
            padding: 1.25rem;
        }

        .project-card--featured .work-title {
            font-size: 1.35rem;
        }
    }
</style>
