---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
    title: string
    description: string
    href: string
    image: ImageMetadata
    action: string
    isLcp?: boolean
}

const { title, description, href, image, action, isLcp = false } = Astro.props
---

<a class="project-card" href={href}>
    <Image
        src={image}
        alt={`Screenshot of ${title}`}
        loading={isLcp ? 'eager' : 'lazy'}
        fetchpriority={isLcp ? 'high' : 'auto'}
        widths={[400, 800]}
        sizes="(max-width: 760px) 100vw, 33vw"
        quality={80}
        class="project-card-img"
    />
    <span class="project-card-body">
        <span class="work-title">{title}</span>
        <span class="work-description">{description}</span>
        <span class="work-action">{action}</span>
    </span>
</a>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        color: inherit;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        overflow: hidden;
        transition:
            background-color 150ms ease,
            border-color 150ms ease;
    }

    .project-card:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: var(--accent);
    }

    .project-card-img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid var(--border-subtle);
    }

    .project-card-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.25rem;
    }

    .work-title {
        font-size: 1.15rem;
        line-height: 1.3;
        font-weight: 600;
    }

    .work-description {
        flex: 1;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--fg-muted);
    }

    .work-action {
        color: var(--accent);
        font-size: 0.9rem;
        text-decoration: underline;
        text-decoration-color: color-mix(
            in srgb,
            var(--accent) 30%,
            transparent
        );
        text-underline-offset: 4px;
        transition:
            color 150ms ease,
            text-decoration-color 150ms ease;
    }

    .project-card:hover .work-action {
        color: var(--fg);
        text-decoration-color: rgb(255 255 255 / 0.8);
    }
</style>
